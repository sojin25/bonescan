import cv2
import numpy as np
from skimage.io import imread
from scipy.spatial.distance import directed_hausdorff
import matplotlib.pyplot as plt

def calculate_dice_coefficient(mask1, mask2):
    intersection = np.logical_and(mask1, mask2)
    return 2. * intersection.sum() / (mask1.sum() + mask2.sum())

def calculate_hausdorff_distance(mask1, mask2):
    # Get the coordinates of the foreground pixels
    coords1 = np.column_stack(np.where(mask1 > 0))
    coords2 = np.column_stack(np.where(mask2 > 0))
    
    # Calculate Hausdorff Distance
    hd_forward = directed_hausdorff(coords1, coords2)[0]
    hd_backward = directed_hausdorff(coords2, coords1)[0]
    
    return max(hd_forward, hd_backward)

def segment_color_regions(img, lower_bound, upper_bound):
    hsv = cv2.cvtColor(img, cv2.COLOR_RGB2HSV)
    mask = cv2.inRange(hsv, lower_bound, upper_bound)
    return mask

def create_overlay_image_with_white_background(img_ref, mask1, mask2, alpha=0.2):
    # Create a white background image with the same dimensions as the input images
    white_background = np.ones_like(img_ref) * 255
    
    # Create an empty image with the same dimensions as the input images
    overlay = np.zeros_like(img_ref)
    
    # Define colors for agreement and disagreement
    agree_color = [0, 255, 0]  # Green for agreement
    disagree_color = [255, 0, 0]  # Red for disagreement
    
    # Agreement (both masks have the same regions)
    overlay[np.logical_and(mask1, mask2)] = agree_color
    
    # Disagreement (masks have different regions)
    overlay[np.logical_xor(mask1, mask2)] = disagree_color
    
    # Blend the white background image with the overlay
    blended = cv2.addWeighted(white_background, alpha, overlay, 1 - alpha, 0)
    
    return blended

def align_images_by_contours(img1, img2):
    # Convert images to grayscale
    gray1 = cv2.cvtColor(img1, cv2.COLOR_RGB2GRAY)
    gray2 = cv2.cvtColor(img2, cv2.COLOR_RGB2GRAY)
    
    # Threshold the images to get binary images
    _, thresh1 = cv2.threshold(gray1, 127, 255, cv2.THRESH_BINARY)
    _, thresh2 = cv2.threshold(gray2, 127, 255, cv2.THRESH_BINARY)
    
    # Find contours
    contours1, _ = cv2.findContours(thresh1, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)
    contours2, _ = cv2.findContours(thresh2, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)
    
    # Get the largest contour in each image
    contour1 = max(contours1, key=cv2.contourArea)
    contour2 = max(contours2, key=cv2.contourArea)
    
    # Get bounding box for each contour
    x1, y1, w1, h1 = cv2.boundingRect(contour1)
    x2, y2, w2, h2 = cv2.boundingRect(contour2)
    
    # Crop the images using the bounding boxes
    img1_cropped = img1[y1:y1+h1, x1:x1+w1]
    img2_cropped = img2[y2:y2+h2, x2:x2+w2]
    
    # Resize the cropped img2 to the size of cropped img1
    img2_aligned = cv2.resize(img2_cropped, (w1, h1))
    
    return img1_cropped, img2_aligned

# Load the images
img1_path = "0130000001-1_origin_output.png"
img2_path = "0130000001-1_filter_output.png"

img1 = imread(img1_path)
img2 = imread(img2_path)

# Align the images by their contours
aligned_img1, aligned_img2 = align_images_by_contours(img1, img2)

# Define the red and blue color ranges in HSV
lower_red1 = np.array([0, 70, 50])
upper_red1 = np.array([10, 255, 255])
lower_red2 = np.array([170, 70, 50])
upper_red2 = np.array([180, 255, 255])
lower_blue = np.array([100, 150, 0])
upper_blue = np.array([140, 255, 255])

# Segment red and blue regions in both aligned images
red_mask_img1 = segment_color_regions(aligned_img1, lower_red1, upper_red1) | segment_color_regions(aligned_img1, lower_red2, upper_red2)
red_mask_img2 = segment_color_regions(aligned_img2, lower_red1, upper_red1) | segment_color_regions(aligned_img2, lower_red2, upper_red2)
blue_mask_img1 = segment_color_regions(aligned_img1, lower_blue, upper_blue)
blue_mask_img2 = segment_color_regions(aligned_img2, lower_blue, upper_blue)

# Create binary masks
binary_red_mask_img1 = red_mask_img1 > 0
binary_red_mask_img2 = red_mask_img2 > 0
binary_blue_mask_img1 = blue_mask_img1 > 0
binary_blue_mask_img2 = blue_mask_img2 > 0

# Calculate Dice coefficients for red and blue regions
dice_red = calculate_dice_coefficient(binary_red_mask_img1, binary_red_mask_img2)
dice_blue = calculate_dice_coefficient(binary_blue_mask_img1, binary_blue_mask_img2)

# Calculate Hausdorff Distance for red and blue regions
hausdorff_red = calculate_hausdorff_distance(binary_red_mask_img1, binary_red_mask_img2)
hausdorff_blue = calculate_hausdorff_distance(binary_blue_mask_img1, binary_blue_mask_img2)

# Display results
print(f"Red regions Dice coefficient: {dice_red}")
print(f"Blue regions Dice coefficient: {dice_blue}")
print(f"Red regions Hausdorff Distance: {hausdorff_red}")
print(f"Blue regions Hausdorff Distance: {hausdorff_blue}")

# Create overlay images for red and blue regions with the white background
red_overlay_with_white_bg = create_overlay_image_with_white_background(aligned_img1, binary_red_mask_img1, binary_red_mask_img2, alpha=0.2)
blue_overlay_with_white_bg = create_overlay_image_with_white_background(aligned_img1, binary_blue_mask_img1, binary_blue_mask_img2, alpha=0.2)

# Display the overlay images with the white background
fig, axes = plt.subplots(1, 2, figsize=(12, 6))
axes[0].imshow(red_overlay_with_white_bg)
axes[0].set_title('Red Regions Agreement (Green) \n and Disagreement (Red) with White Background')
axes[1].imshow(blue_overlay_with_white_bg)
axes[1].set_title('Blue Regions Agreement (Green) \n and Disagreement (Red) with White Background')
plt.tight_layout()
plt.show()
